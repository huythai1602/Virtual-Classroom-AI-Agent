# ==============================================
# ENVIRONMENT CONFIGURATION - LangGraph AI Agent
# ==============================================
# Copy file này thành .env và điền các giá trị thực

# OpenAI API Key (BẮT BUỘC)
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Ngrok Auth Token (Tùy chọn - để expose API ra public URL)
# Lấy từ: https://dashboard.ngrok.com/get-started/your-authtoken
# Nếu không có, bỏ qua hoặc để trống
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# LangSmith (Tùy chọn - để debug và trace LangGraph)
# Lấy từ: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=langgraph-agent

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration (BẮT BUỘC)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=virtual_classroom
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=your-secure-password-here

# Google Custom Search API (Tùy chọn - cho external search)
# Lấy API key: https://developers.google.com/custom-search/v1/introduction
# Tạo Custom Search Engine: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-custom-search-engine-id-here

# Logging
LOG_LEVEL=INFO

# ==============================================
# HƯỚNG DẪN SỬ DỤNG:
# ==============================================
# 1. Copy file này: cp .env.example .env (Windows: copy .env.example .env)
# 2. Mở file .env và điền OPENAI_API_KEY
# 3. Các biến khác có thể giữ mặc định
# 4. KHÔNG commit file .env vào Git!
# ==============================================
